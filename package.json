{
  "name": "anointed-worship-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-production-env.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:website": "eslint src/app src/components src/lib src/proxy.ts e2e scripts next.config.ts playwright.config.ts vitest.website.config.ts --max-warnings 0 --ignore-pattern src/app/api/desktop/** --ignore-pattern src/app/presenter/desktop-* --ignore-pattern src/components/desktop-* --ignore-pattern src/lib/desktop/** --ignore-pattern src/lib/presentation/use-desktop-remote-channel* --ignore-pattern src/lib/presentation/lan-remote-static.test.ts --ignore-pattern scripts/import-desktop-bible.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:website": "vitest run --config vitest.website.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:website": "vitest run --config vitest.website.config.ts --coverage",
    "test:e2e": "playwright test",
    "check:production-env": "node scripts/check-production-env.mjs --force",
    "smoke:production": "node scripts/smoke-production.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "lint:database:website": "node scripts/check-supabase-lint.mjs",
    "supabase:init": "supabase init",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "test:supabase:website": "node scripts/test-local-supabase-security.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/canvas": "0.1.100",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-virtual": "^3.14.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@zxing/browser": "0.2.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.22.0",
    "next": "^16.2.12",
    "pdfjs-dist": "^5.4.624",
    "pitchy": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.24",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
